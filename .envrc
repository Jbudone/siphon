# Secrets remain in the existing vault; direnv unloads them when leaving Siphon.
use_secret MESHY_API_KEY meshy-key
if [[ -z "${MESHY_API_KEY:-}" ]]; then
  log_error "Meshy key missing from vault entry meshy-key"
  return 1
fi

# Fast local warning; the user timer performs the actual refresh/access check.
python3 tools/unity_auth.py --cached || true
